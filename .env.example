# Copy this file to ~/.config/antigravity-proxy/.env and chmod it 600.
# Never commit real values.

# Required only for Google Cloud Code account OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional Web UI and legacy API protection.
WEBUI_PASSWORD=
API_KEY=

# Optional runtime configuration.
PORT=8080
HOST=127.0.0.1
CLAUDE_CONFIG_PATH=
